@startuml
title Figure 8. Tactical DDD Domain Model with Isolated Aggregates and Explicit Consistency Boundaries
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 10
skinparam roundCorner 8
skinparam classAttributeIconSize 0

skinparam package {
  BackgroundColor #FDFBF7
  BorderColor #7A6253
  FontSize 12
  FontStyle bold
}

skinparam class {
  BackgroundColor #FFF8EE
  BorderColor #8D5B4C
  FontSize 10
  HeaderBackgroundColor #FCEBD9
}

skinparam stereotypeCBackgroundColor #E2D4C9

package "Common types (Shared Kernel)" as SharedKernel {
  class StudentId <<Value Object>> {
    + value: UUID
  }

  class MobilityId <<Value Object>> {
    + value: UUID
  }

  class AcademicPeriod <<Value Object>> {
    + startDate: LocalDate
    + endDate: LocalDate
  }

  class ECTSCredits <<Value Object>> {
    + value: BigDecimal
  }
}

package "Learning Agreement Management (Core Domain)" as CoreDomain {
  class ECTSParityService <<Domain Service>> {
    + validateBalance(tableA: List<CourseLineTableA>, tableB: List<CourseLineTableB>): boolean
    + calculateDeficit(tableA: List<CourseLineTableA>, tableB: List<CourseLineTableB>): BigDecimal
  }

  class LearningAgreement <<Aggregate Root>> {
    - id: UUID
    - mobilityId: MobilityId
    - studentId: StudentId
    - hostUniversityId: String
    - academicPeriod: AcademicPeriod
    - status: LearningAgreementStatus
    - tableALines: List<CourseLineTableA>
    - tableBLines: List<CourseLineTableB>
    - academicYear: String
    - rejectionNotes: String
    + addTableALine(code: String, title: String, ects: ECTSCredits, term: String): void
    + addTableBLine(code: String, title: String, ects: ECTSCredits, term: String): void
    + removeCourseLine(lineId: UUID): void
    + validateEctsBalance(): boolean
    + submit(): LearningAgreementSubmittedEvent
    + approveByFaculty(coordinatorId: String): LearningAgreementApprovedEvent
    + requestChanges(notes: String): void
    + confirmByHost(): LearningAgreementConfirmedEvent
    + cancel(): LearningAgreementCancelledEvent
  }

  class CourseLineTableA <<Entity>> {
    - lineId: UUID
    - courseCode: String
    - courseTitle: String
    - credits: ECTSCredits
    - semesterTerm: String
    - instructionLanguage: String
    + updateCredits(credits: ECTSCredits): void
  }

  class CourseLineTableB <<Entity>> {
    - lineId: UUID
    - homeCourseCode: String
    - homeCourseTitle: String
    - credits: ECTSCredits
    - semesterTerm: String
    - equivalentCourseCode: String
    + updateCredits(credits: ECTSCredits): void
  }

  enum LearningAgreementStatus <<Enum>> {
    DRAFT
    SUBMITTED
    UNDER_REVIEW
    APPROVED_BY_FACULTY
    CONFIRMED_BY_HOST
    AMENDED
    CANCELLED
  }

  ECTSParityService ..> LearningAgreement : <<use>>
  LearningAgreement *-- "1..*" CourseLineTableA : composition
  LearningAgreement *-- "1..*" CourseLineTableB : composition
  LearningAgreement --> LearningAgreementStatus
}

package "Equivalence Management (Supporting)" as EquivalenceDomain {
  class SyllabusEvaluationService <<Domain Service>> {
    + calculateSimilarityScore(source: CourseSyllabus, target: CourseSyllabus): double
  }

  class AcademicEquivalence <<Aggregate Root>> {
    - id: UUID
    - partnerUniversityId: String
    - hostCourseCode: String
    - hostCourseTitle: String
    - homeCourseCode: String
    - homeCourseTitle: String
    - credits: ECTSCredits
    - syllabus: CourseSyllabus
    - status: EquivalenceStatus
    - validityPeriod: AcademicPeriod
    + evaluateSyllabus(committeeNotes: String): void
    + approve(evaluatorId: String): EquivalenceApprovedEvent
    + retire(): void
    + isCompatibleWith(criteria: String): boolean
  }

  class CourseSyllabus <<Value Object>> {
    - learningOutcomes: String
    - weeklyHours: int
    - thematicUnits: String
    - gradingCriteria: String
  }

  enum EquivalenceStatus <<Enum>> {
    PROPOSED
    UNDER_EVALUATION
    APPROVED
    ACTIVE
    RETIRED
  }

  SyllabusEvaluationService ..> AcademicEquivalence : <<use>>
  AcademicEquivalence *-- CourseSyllabus : holds
  AcademicEquivalence --> EquivalenceStatus
}

package "Mobility Preparation (Supporting)" as PreparationDomain {
  class MobilityChecklist <<Aggregate Root>> {
    - id: ChecklistId
    - studentId: StudentId
    - agreementId: AgreementId
    - tasks: List<ChecklistTask>
    + initializeDefaultPreparationTasks(): void
    + completeTask(taskId: TaskId): void
    + areMandatoryTasksComplete(): boolean
    + flagOverdueTasks(asOf: LocalDate): void
  }

  class ChecklistTask <<Child Entity>> {
    - taskId: TaskId
    - taskType: TaskType
    - title: String
    - deadline: LocalDate
    - status: TaskStatus
    - proofDocumentUri: String
    + assignToStudent(): void
    + attachProof(uri: String): void
    + markSubmitted(): void
    + markCompleted(): void
    + markOverdue(): void
  }

  enum TaskType <<Enum>> {
    OLS_LANGUAGE_ASSESSMENT
    MEDICAL_INSURANCE_EHIC
    VISA_DOCUMENTATION
    GRANT_AGREEMENT
    LEARNING_AGREEMENT_APPROVAL
  }

  enum TaskStatus <<Enum>> {
    INITIALIZED
    PENDING_STUDENT_ACTION
    SUBMITTED_FOR_VERIFICATION
    COMPLETED
    OVERDUE
    ABANDONED
  }

  MobilityChecklist "1" *-- "1..*" ChecklistTask : encapsulates
  ChecklistTask --> TaskStatus
  ChecklistTask --> TaskType
}

LearningAgreement --> StudentId
LearningAgreement --> MobilityId
LearningAgreement --> AcademicPeriod
CourseLineTableA --> ECTSCredits
CourseLineTableB --> ECTSCredits
AcademicEquivalence --> AcademicPeriod
AcademicEquivalence --> ECTSCredits
MobilityChecklist --> StudentId
MobilityChecklist --> AgreementId
ChecklistTask --> TaskId

@enduml


@startuml
title Figure 3. Learning Agreement — actor goals (Alin)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #334155
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #B99B41
skinparam nodesep 22
skinparam ranksep 30
skinparam usecaseBackgroundColor #F8FAFC
left to right direction
actor Student as S
actor "Home academic\ncoordinator" as C
actor "DRI officer" as D
actor "Host coordinator\n(external evidence source)" as H
rectangle "Learning Agreement Management" {
 usecase "Create or edit\nthe study-plan draft" as Draft
 usecase "UC01: Submit\nLearning Agreement" as Submit
 usecase "Check mappings, credits\nand catalog eligibility" as Validate
 usecase "View agreement status" as Track
 usecase "Request withdrawal\nbefore departure" as Withdraw
 usecase "Begin academic review" as Review
 usecase "Request corrections" as Changes
 usecase "Approve for home faculty" as Approve
 usecase "Record host confirmation" as Confirm
 usecase "UC08: Record withdrawal\nand cancel agreement" as Cancel
}
S -- Draft : edits own draft
S -- Submit : submits own plan
S -- Track : views own status
S -- Withdraw : requests withdrawal
Submit ..> Validate : <<include>>
C -- Review : starts review
C -- Changes : requests changes
C -- Approve : approves plan
D -- Confirm : records evidence
H -- Confirm : supplies evidence
D -- Cancel : records cancellation
legend bottom
  A student requests withdrawal; only an authorized DRI officer
  records cancellation. The request does not cancel the plan itself.
endlegend
@enduml

@startuml
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam LegendFontSize 12
skinparam shadowing false
skinparam ParticipantPadding 5
skinparam BoxPadding 4
skinparam sequenceMessageAlign center
skinparam maxMessageSize 145
skinparam sequence {
 LifeLineBorderColor #64748B
 ParticipantBackgroundColor #F1F5F9
 GroupBackgroundColor #FFFFFF
 GroupBodyBackgroundColor #FFFFFF
}
hide footbox
title Figure 23. UC02 — evaluate and publish an equivalence (Mihai)
actor "Academic\ncoordinator" as Evaluator
boundary "ui\n:EvaluatorPortal" as UI
control "api\n:Equivalence\nApiRest" as API
participant "service\n:Equivalence\nApplication\nService" as Service
participant "repo\n:Academic\nEquivalence\nRepoJPA" as Repo
participant "equivalence\n:Academic\nEquivalence" as EQ
Evaluator -> UI : Publish evaluated proposal
UI -> API : evaluateAndPublish(cmd)
API -> Service : evaluateAndPublish(cmd)
Service -> Repo : findById(equivalenceId)
Repo --> Service : proposal / missing
break missing / unauthorized / wrong state or version
 Service --> API : reject request
end
group Local publication transaction
 Service -> Repo : hasOverlappingRule(query)
 Repo --> Service : boolean
 alt overlapping active rule
  Service --> API : conflict; no publication
 else no overlap found
!ifdef A4_PANELS
newpage UC02 continued — publish after the overlap check
  note over Service, Repo : No overlap found; continue the same local transaction.
!endif
  Service -> EQ : approveAndPublish(score, rationale, actorId)
  alt invalid score, credits, period or rationale
   EQ --> Service : validation error
   Service --> API : remain UNDER_EVALUATION
  else evaluation valid
   EQ --> Service : ACTIVE + decision
   Service -> Repo : saveIfVersionMatches(equivalence, expectedVersion)
   alt version / uniqueness / persistence conflict
    Repo --> Service : false / error
    note over Service, Repo : ROLLBACK
    Service --> API : conflict; reload
   else save succeeded
    Repo --> Service : true
    note over Service, Repo : COMMIT rule + audit
    Service --> API : success
    API --> UI : Publication confirmed
    UI --> Evaluator : Rule available
   end
  end
 end
end
legend bottom
 Precondition: UNDER_EVALUATION; beginEvaluation(actorId) was committed earlier.
 Check cmd.expectedVersion; require score >= 80, equal credits and a rationale.
 Persistence protects key/period uniqueness against concurrent publications.
 Validation failure is not the separate decision reject(actorId, reason).
endlegend
@enduml

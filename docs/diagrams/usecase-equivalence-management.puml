@startuml
title Figure 4. Equivalence Management — actor goals (Mihai)
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #334155
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #B99B41
skinparam nodesep 22
skinparam ranksep 30
skinparam usecaseBackgroundColor #F8FAFC
left to right direction
actor Student as S
actor "Learning Agreement\n(consuming module)" as LA
actor "Home academic\ncoordinator" as C
rectangle "Equivalence Management" {
 usecase "Search rules for institutions\nand mobility period" as Search
 usecase "Propose a 1:1\ncourse equivalence" as Propose
 usecase "UC04: Begin evaluation" as Begin
 usecase "UC02: Evaluate and publish\na proposed equivalence" as Evaluate
 usecase "Check score, credits,\nvalidity and uniqueness" as Validate
 usecase "Reject a proposal\nwith rationale" as Reject
 usecase "Retire an active rule" as Retire
}
S -- Search : searches catalog
S -- Propose : submits proposal
LA -- Search : requests eligibility
C -- Begin : takes proposal for review
C -- Evaluate : evaluates and publishes
C -- Reject : records rejection
C -- Retire : retires rule
Evaluate ..> Validate : <<include>>
legend bottom
  UC02 starts with UNDER_EVALUATION.
  Invalid input leaves the proposal under evaluation;
  explicit rejection is a separate decision.
endlegend
@enduml

@startuml
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam LegendFontSize 12
skinparam shadowing false
skinparam ParticipantPadding 5
skinparam BoxPadding 4
skinparam sequenceMessageAlign center
skinparam maxMessageSize 145
skinparam sequence {
 LifeLineBorderColor #64748B
 ParticipantBackgroundColor #F1F5F9
 GroupBackgroundColor #FFFFFF
 GroupBodyBackgroundColor #FFFFFF
}
hide footbox
title Figure 24. Host confirmation and reliable publication (shared)
actor "DRI\nofficer" as DRI
control "controller\n:Learning\nAgreement\nWebController" as Controller
participant "service\n:Agreement\nApplication\nService" as Service
participant "repo\n:Learning\nAgreement\nRepoJPA" as Repo
participant "agreement\n:Learning\nAgreement" as LA
participant "outbox\n:OutboxRepoJPA" as Outbox
participant "worker\n:Outbox\nDispatcher" as Worker
participant "publisher\n:Message\nPublisher\nAdapter" as Publisher
queue "Message\ntransport" as Broker
DRI -> Controller : confirmHost(cmd)
Controller -> Service : confirmHost(cmd)
Service -> Repo : findById(agreementId)
Repo --> Service : agreement / missing
break actor, evidence, revision or version invalid
 Service --> Controller : reject confirmation
end
!ifdef A4_PANELS
newpage Host confirmation continued — commit the agreement and event
!endif
group Local transaction: agreement + audit + outbox
 Service -> LA : confirmByHost(officerId, proofRef, now)
 LA --> Service : HOST_CONFIRMED event
 Service -> Repo : saveIfVersionMatches(agreement, expectedVersion)
 break conflict / save failed
  Repo --> Service : false / error
  note over Service, Outbox : ROLLBACK; discard event
  Service --> Controller : conflict; reload
 end
 Repo --> Service : true
 Service -> Outbox : append(event)
 alt outbox write failed
  Outbox --> Service : error
  note over Service, Outbox : ROLLBACK both writes
  Service --> Controller : confirmation failed
 else persistence succeeded
  Outbox --> Service : void
  note over Service, Outbox : COMMIT
  Service --> Controller : success
  Controller --> DRI : Confirmation recorded
 end
end
!ifdef A4_PANELS
newpage Publication continued — dispatch committed outbox messages
!endif
== Independent worker after commit ==
Worker -> Outbox : findPending(limit)
Outbox --> Worker : pending messages
loop each claimed message
 Worker -> Publisher : publish(event)
 Publisher ->> Broker : Send payload
 alt durable publisher confirm
  Broker ->> Publisher : Accept payload
  Publisher --> Worker : accepted
  Worker -> Outbox : markPublished(eventId)
  Outbox --> Worker : void
 else failure / timeout
  Publisher --> Worker : retryable error
 end
end
legend bottom
 Compare cmd.expectedVersion; evidence must match the approved revision.
 Recording confirmation succeeds independently of transport availability.
 A publish/mark crash can cause duplicates; consumers must be idempotent.
 Multiple workers need a transactional claim. CANCELLED follows the same contract.
endlegend
@enduml

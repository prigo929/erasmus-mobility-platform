@startuml
title Figure 2. Erasmus dossier — shared business process
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam shadowing false
skinparam activityBackgroundColor #F8FAFC
skinparam ArrowColor #334155
skinparam noteBackgroundColor #FFF7DB
skinparam activityDiamondFontSize 13
skinparam ranksep 10
skinparam activityPadding 3
skinparam activityMargin 3
<style>
activityDiagram {
  activity {
    Padding 4
    Margin 4
  }
  diamond {
    Padding 2
    Margin 2
  }
}
</style>
start
partition "Preparation" {
 :Register nomination and its unique checklist;
}
fork
 partition "Equivalence" {
  repeat
   :Find or evaluate eligible mappings;
  repeat while (Eligible mappings missing?) is (yes) not (no)
 }
 partition "Learning Agreement" {
  repeat
   :Prepare and submit the plan;
   :Faculty reviews the agreement;
   backward :DRAFT: record corrections;
  repeat while (Corrections requested?) is (yes) not (approved)
  :Record host confirmation + outbox;
 }
 partition "Preparation" {
  :Apply event to the existing LA task;
 }
fork again
 partition "Preparation" {
  repeat
   :Submit proofs; DRI reviews them;
  repeat while (Administrative proofs incomplete?) is (yes) not (no)
 }
end fork
partition "Preparation" {
 if (Withdrawal recorded?) then (yes)
  :Invalidate readiness; preserve history;
  stop
 else (no)
  :Check requirements; confirm readiness\nonly if the dossier is complete;
 endif
}
stop
legend bottom
 Detailed validation: UC01/UC02; cancellation: states/events.
 Host events update the existing checklist; no payment is executed.
endlegend
@enduml

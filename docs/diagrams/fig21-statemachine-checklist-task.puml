@startuml
!pragma layout smetana
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ranksep 25
skinparam nodesep 25
skinparam roundcorner 6
skinparam ArrowColor #334155
skinparam stateBackgroundColor #F8FAFC
skinparam legendBackgroundColor #FFF7DB
hide empty description
title Figure 21. ChecklistTask lifecycle (shared)
state "Active task" as ActiveTask {
 [*] --> INITIALIZED
 INITIALIZED --> PENDING_STUDENT_ACTION : taskAssigned\n/ assignToStudent()
 PENDING_STUDENT_ACTION --> SUBMITTED_FOR_VERIFICATION : proofSubmitted\n[administrativeTask && validProofMetadata]\n/ submitProof(proof)
 SUBMITTED_FOR_VERIFICATION --> PENDING_STUDENT_ACTION : proofRejected\n[officerAuthorized && reasonProvided]\n/ rejectProof(reason)
 PENDING_STUDENT_ACTION --> OVERDUE : deadlineChecked(asOf)\n[asOf > deadline && noProofSubmitted]\n/ markOverdue(asOf)
 OVERDUE --> SUBMITTED_FOR_VERIFICATION : lateProofSubmitted\n[administrativeTask]\n/ submitProof(proof)
}
[*] --> ActiveTask
SUBMITTED_FOR_VERIFICATION --> COMPLETED : proofApproved [officerAuthorized]\n/ approveProof()
ActiveTask --> COMPLETED : hostConfirmationApplied\n[academicTask && validEvent\n&& awaitingAcademicConfirmation]\n/ completeFromAgreement()
ActiveTask --> ABANDONED : mobilityWithdrawn\n/ abandon()
COMPLETED --> [*]
ABANDONED --> [*]
legend bottom
 awaitingAcademicConfirmation = PENDING_STUDENT_ACTION or OVERDUE.
endlegend
@enduml

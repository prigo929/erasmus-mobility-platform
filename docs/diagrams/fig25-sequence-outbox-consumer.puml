@startuml
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam LegendFontSize 12
skinparam shadowing false
skinparam ParticipantPadding 5
skinparam BoxPadding 4
skinparam sequenceMessageAlign center
skinparam maxMessageSize 145
skinparam sequence {
 LifeLineBorderColor #64748B
 ParticipantBackgroundColor #F1F5F9
 GroupBackgroundColor #FFFFFF
 GroupBodyBackgroundColor #FFFFFF
}
hide footbox
title Figure 25. Idempotent consumer — update an existing checklist (shared)
queue "Message\ntransport" as Broker
participant "receiver\n:Agreement\nMessage\nReceiver" as Receiver
participant "service\n:Preparation\nApplication\nService" as Service
participant "ledger\n:Processed\nEventRepoJPA" as Ledger
participant "repo\n:Mobility\nChecklist\nRepoJPA" as Repo
participant "checklist\n:Mobility\nChecklist" as Checklist
Broker ->> Receiver : onMessage(event)
Receiver -> Service : applyAgreementEvent(event)
group Local transaction: eventId + effect + audit
 Service -> Ledger : tryRecord(event.eventId)
 alt already processed
  Ledger --> Service : false
 else eventId inserted uniquely
  Ledger --> Service : true
  Service -> Repo : findByMobilityId(event.mobilityId)
  Repo --> Service : checklist / missing
  break missing checklist or mismatched agreementId
   note over Service, Repo : ROLLBACK eventId; do not create a dossier
   Service --> Receiver : retryable error
   note over Receiver, Broker : No success ACK
  end
!ifdef A4_PANELS
newpage Consumer continued — apply the event and commit
  note over Service, Repo : Event ID reserved and dossier found; continue the same local transaction.
!endif
  Service -> Checklist : applyAgreementEvent(event)
  alt stale version or confirmation after cancellation
   Checklist --> Service : no reactivation
  else applicable HOST_CONFIRMED
   Checklist --> Service : academic task COMPLETED
  else new CANCELLED
   Checklist --> Service : dossier CANCELLED
  end
  Service -> Repo : save(checklist)
  alt persistence failure / concurrent update conflict
   Repo --> Service : error
   note over Service, Repo : ROLLBACK effect + eventId
   break transaction failed
    Service --> Receiver : retryable error
    note over Receiver, Broker : No success ACK
   end
  else save succeeded
   Repo --> Service : void
   note over Service, Repo : COMMIT effect + eventId
  end
 end
end
Service --> Receiver : committed success / confirmed duplicate
Receiver ->> Broker : ACK
legend bottom
 eventId uniqueness and checklist serialization protect concurrent processing.
 sourceVersion orders events from the same agreement; cancellation stays effective.
 Missing dossiers and save failures roll back the ledger insertion and allow retry.
 Active tasks are abandoned on cancellation; completed evidence remains historical.
endlegend
@enduml

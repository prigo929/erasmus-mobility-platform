@startuml
title <color:white>Figure 5. Mobility Preparation — shared actor goals</color>
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #334155
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #B99B41
skinparam nodesep 22
skinparam ranksep 30
skinparam usecaseBackgroundColor #F8FAFC
left to right direction
actor Student as S
actor "DRI officer" as D
actor "Learning Agreement\n(publishing module)" as LA
rectangle "Mobility Preparation" {
 usecase "Register\nexisting nomination" as Nominate
 usecase "Initialize checklist\nfor MobilityId" as Init
 usecase "View checklist\nand deadlines" as View
 usecase "Submit administrative\nevidence" as Upload
 usecase "Review submitted\nevidence" as Verify
 usecase "Approve evidence" as Approve
 usecase "Reject evidence\nwith rationale" as Reject
 usecase "UC03: Apply agreement\nconfirmation or cancellation event" as Sync
 usecase "UC07: Confirm\ndossier readiness" as Ready
 usecase "Check all mandatory\nrequirements" as Gate
 usecase "Request withdrawal\nbefore departure" as Withdraw
 usecase "Record withdrawal and\ninvalidate dossier" as Cancel
}
S -- View : views own progress
S -- Upload : submits own evidence
S -- Withdraw : requests withdrawal
D -- Nominate : records nomination
D -- Verify : reviews evidence
D -- Approve : approves evidence
D -- Reject : rejects evidence
D -- Ready : confirms readiness
D -- Cancel : records withdrawal
LA -- Sync : publishes agreement events
Nominate ..> Init : <<include>>
Approve ..> Verify : <<include>>
Reject ..> Verify : <<include>>
Ready ..> Gate : <<include>>
legend bottom
  Agreement events update an existing checklist.
  Nomination alone creates the checklist.
endlegend
caption Figure 5. Mobility Preparation — shared actor goals
@enduml
